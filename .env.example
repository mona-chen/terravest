# Railway Environment Variables
# Add these in your Railway project dashboard under Variables

# Database (Railway PostgreSQL plugin will provide this automatically)
DATABASE_URL=postgresql://user:password@host:port/terravest

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# Environment
NODE_ENV=production

# Server (Railway sets PORT automatically, backend uses 3001 internally)
# PORT=80

# Optional JWT settings
# JWT_ISSUER=terravest
# JWT_AUDIENCE=terravest-api
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d
