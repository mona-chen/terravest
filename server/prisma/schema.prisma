datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Extended data model for TerraVest seed data ( Wave 3 )
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(INVESTOR)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())

  investors      Investor[]    @relation("UserInvestors")
  documents      Document[]
  notifications  Notification[]
  messages       Message[]     @relation("UserMessages")
  receivedMessages Message[]   @relation("UserMessagesRecipient")
  refreshTokens  RefreshToken[]
}

enum UserRole {
  ADMIN
  INVESTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Investor {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id], name: "UserInvestors")
  userId        String   @unique
  firstName     String?
  lastName      String?
  email         String   @unique
  phone         String?
  company       String?
  avatar        String?
  totalInvested Decimal  @default(0)
  netWorth      Decimal  @default(0)
  joinedAt      DateTime @default(now())
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())

  portfolioHoldings PortfolioHolding[]
  documents        Document[]
  capitalCalls     CapitalCall[]
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  sector      String
  valuation   Decimal
  revenue     Decimal
  employees   Int
  createdAt   DateTime @default(now())

  portfolioHoldings PortfolioHolding[]
  opportunities     Opportunity[]
  documents         Document[]
}

model PortfolioHolding {
  id          String   @id @default(uuid())
  investor    Investor @relation(fields: [investorId], references: [id])
  investorId  String
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  shares      Decimal
  purchasePrice Decimal
  status      PortfolioStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
}

model Document {
  id           String   @id @default(uuid())
  name         String
  category     String   @default("General")
  fileType     String
  size         String   @default("0 KB")
  url          String
  isPublic     Boolean  @default(false)
  accessLevel  String   @default("ALL")
  downloads    Int      @default(0)
  starred      Boolean  @default(false)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  company      Company? @relation(fields: [companyId], references: [id])
  companyId    String?
  investor     Investor? @relation(fields: [investorId], references: [id])
  investorId   String?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String       @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  read      Boolean      @default(false)
  createdAt DateTime     @default(now())
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
}

model Message {
  id          String @id @default(uuid())
  subject     String @default("")
  content     String
  sender      User   @relation("UserMessages", fields: [senderId], references: [id])
  senderId    String
  recipient   User   @relation("UserMessagesRecipient", fields: [recipientId], references: [id])
  recipientId String
  read        Boolean @default(false)
  createdAt   DateTime @default(now())
}

model Opportunity {
  id            String  @id @default(uuid())
  company       Company @relation(fields: [companyId], references: [id])
  companyId     String
  title         String
  targetAmount  Decimal
  minimumInvestment Decimal
  status        OpportunityStatus @default(OPEN)
  createdAt     DateTime @default(now())
}

enum OpportunityStatus {
  OPEN
  CLOSED
}

model CapitalCall {
  id          String           @id @default(uuid())
  investor    Investor         @relation(fields: [investorId], references: [id])
  investorId  String
  amount      Decimal
  dueDate     DateTime
  status      CapitalCallStatus  @default(PENDING)
  createdAt   DateTime @default(now())
}

enum CapitalCallStatus {
  PENDING
  PAID
}

enum PortfolioStatus {
  ACTIVE
  PENDING
  EXITED
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
}
